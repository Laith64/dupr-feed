{
  "mcpServers": {
    "playwright": {
      "command": "/opt/homebrew/bin/npx",
      "args": ["@playwright/mcp@latest", "--headless"],
      "alwaysAllow": [
        "browser_navigate",
        "browser_take_screenshot",
        "browser_click",
        "browser_type",
        "browser_fill_form",
        "browser_evaluate",
        "browser_snapshot",
        "browser_navigate_back",
        "browser_close",
        "browser_wait_for",
        "browser_console_messages",
        "browser_network_requests",
        "browser_tabs",
        "browser_resize"
      ]
    }
  }
}
